<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Self-hosted ONNX cross-encoder reranker for the SmartDocs RAG stack (bge-reranker-v2-m3 over Microsoft.ML.OnnxRuntime). The opt-in package that pulls the native ONNX runtime, kept out of the lean core so other consumers never pay for it.</Description>
    <PackageTags>rag;reranking;onnx;cross-encoder;bge;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocs.Reranking\SmartDocs.Reranking.csproj" />
    <ProjectReference Include="..\SmartDocs.Core\SmartDocs.Core.csproj" />
  </ItemGroup>

</Project>
