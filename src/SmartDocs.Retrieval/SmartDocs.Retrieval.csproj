<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Retrieval engine for the SmartDocs RAG stack: dense/sparse/hybrid retrievers, Reciprocal Rank Fusion, MMR and context ordering, query-enhancement decorators (HyDE, RAG-Fusion, CRAG, step-back), graph/vectorless retrieval, and the in-memory vector store. Backend-specific adapters ship as separate SmartDocs.Retrieval.* packages.</Description>
    <PackageTags>rag;retrieval;hybrid-search;rrf;reranking;vector-search;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Neo4j.Driver" />
    <!-- Ch 14: Postgres + pgvector single-store hybrid adapter
         (PostgresHybridRetriever). The version is pinned centrally in
         Directory.Packages.props (Npgsql 10.0.3). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocs.Core\SmartDocs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit tests assert on the internal index/collection builders
         (BuildVectorParams, BuildIndex, ToSearchDocument, ...) without a live
         Qdrant or Azure AI Search service. -->
    <InternalsVisibleTo Include="SmartDocs.UnitTests" />
  </ItemGroup>

</Project>
