<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Document ingestion for the SmartDocs RAG stack: loaders, chunkers (recursive, semantic, code-aware via Roslyn, PDF via PdfPig), and the embedding pipeline that turns raw documents into embedded chunks ready for indexing.</Description>
    <PackageTags>rag;ingestion;chunking;embeddings;pdf;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- BackgroundService base type for the Ch 22 IngestEventConsumer. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocs.Core\SmartDocs.Core.csproj" />
  </ItemGroup>

</Project>
