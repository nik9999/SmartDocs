<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Reranking layer for the SmartDocs RAG stack: the IReranker abstraction, a no-op control, an LLM reranker, and the Scrutor-based reranking middleware that transparently decorates an IRetriever. Hosted cross-encoder (ONNX) and Cohere adapters ship as separate SmartDocs.Reranking.* packages.</Description>
    <PackageTags>rag;reranking;cross-encoder;relevance;ai;llm;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartDocs.Core\SmartDocs.Core.csproj" />
    <ProjectReference Include="..\SmartDocs.Retrieval\SmartDocs.Retrieval.csproj" />
  </ItemGroup>

</Project>
